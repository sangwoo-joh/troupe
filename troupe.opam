# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "An actor model built on OCaml 5 effects"
description:
  "Troupe is a small actor library where each actor runs as its own fiber, processes messages from a private mailbox, and blocks in a selective receive until a matching message arrives."
maintainer: ["Sangwoo Joh <work.sangwoo.joh@gmail.com>"]
authors: ["Sangwoo Joh <work.sangwoo.joh@gmail.com>"]
license: "LICENSE"
homepage: "https://github.com/sangwoo-joh/troupe"
bug-reports: "https://github.com/sangwoo-joh/troupe/issues"
depends: [
  "ocaml" {>= "5.1"}
  "dune" {>= "3.19"}
  "iomux"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/sangwoo-joh/troupe.git"
x-maintenance-intent: ["(latest)"]
